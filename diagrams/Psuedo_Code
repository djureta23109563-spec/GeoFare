// GeoFare: Manage Trip & Fare Computation (DFD Level 2 Process 1.0)
void function ProcessTripAndFare
    // Sub-process 1.1: Capture Pickup Location
    Receive passengerTripRequest
    pickupGPS = getCurrentLocation()
    Save pickupGPS to Trip_Logs

    // Sub-process 1.2: Capture Drop-off Location
    Receive destinationInput
    dropoffGPS = getDestinationLocation()
    Save dropoffGPS to Trip_Logs

    // Sub-process 1.3: Calculate Distance & Fare
    tripDistance = computeDistance(pickupGPS, dropoffGPS)
    computedFare = applyLocalFareRules(tripDistance)
    Save tripDistance, computedFare to Trip_Logs

    Display computedFare to passenger
END function
